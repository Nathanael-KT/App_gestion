# IMPORTANT: Ne pas commiter ce fichier en production
# Copier ce fichier en .env et remplir avec vos vraies valeurs

# =============================================================================
# SUPABASE CONFIGURATION (Production)
# =============================================================================
# URL de votre projet Supabase en production
SUPABASE_URL=https://your-project-ref.supabase.co
# Clé publique anon de Supabase  
SUPABASE_ANON_KEY=your_anon_public_key
# Clé de service role (SENSIBLE - garde secret)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# =============================================================================
# NUXT CONFIGURATION
# =============================================================================
# Variables publiques (exposées côté client)
NUXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NUXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_public_key
NUXT_PUBLIC_SITE_URL=https://your-domain.com

# Compatibilité éventuelle avec anciens scripts
SUPABASE_KEY=your_anon_public_key

# =============================================================================
# CRON / TÂCHES PLANIFIÉES
# =============================================================================
# Secret partagé requis dans le header "x-cron-secret" pour appeler
# /api/cron/update-subscription-status. Générer une valeur aléatoire forte
# (ex: openssl rand -hex 32) et la configurer côté scheduler (GitHub Actions,
# Vercel Cron) ET côté serveur.
CRON_SECRET=your_random_cron_secret

# =============================================================================
# STRIPE (paiement des abonnements)
# =============================================================================
# Clé secrète Stripe (dashboard Stripe > Developers > API keys).
# Utiliser une clé de TEST (sk_test_...) tant que l'intégration n'est pas
# validée en production.
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

# Secret de signature du webhook (dashboard Stripe > Developers > Webhooks
# > votre endpoint > "Signing secret"). Indispensable pour vérifier que les
# événements reçus sur /api/stripe/webhook proviennent bien de Stripe.
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret

# URL publique de l'application, utilisée pour construire les URLs de
# redirection après paiement (success_url/cancel_url) et le retour du
# portail client. En production, mettre l'URL réelle du site.
PUBLIC_APP_URL=http://localhost:3000

# Après avoir créé les 2 produits/prix dans le dashboard Stripe (offres
# "Rapide" et "Pro", voir supabase/migrations/20260821090000_stripe_subscriptions.sql),
# reporter les stripe_price_id correspondants dans la table
# subscription_plans (colonne stripe_price_id), par exemple via le SQL
# Editor de Supabase :
#   update subscription_plans set stripe_price_id = 'price_xxx' where slug = 'rapide';
#   update subscription_plans set stripe_price_id = 'price_yyy' where slug = 'pro';

# =============================================================================
# DOCKER CONFIGURATION
# =============================================================================
# Configuration pour le déploiement Docker
NODE_ENV=production
NITRO_PORT=3000
NITRO_HOST=0.0.0.0

# =============================================================================
# DEVELOPPEMENT LOCAL
# =============================================================================
# Pour le développement local avec Supabase local
# SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_ANON_KEY=your_local_anon_key
# NUXT_PUBLIC_SITE_URL=http://localhost:3000

# =============================================================================
# INSTRUCTIONS DE DÉPLOIEMENT VERCEL + CI/CD
# =============================================================================
# 1. Créer un projet Supabase en production
# 2. Récupérer l'URL et les clés depuis le dashboard Supabase
# 3. Configurer GitHub Secrets pour le CI/CD :
#    - SUPABASE_URL
#    - SUPABASE_ANON_KEY  
#    - SUPABASE_SERVICE_ROLE_KEY
#    - SUPABASE_PROJECT_ID
#    - SUPABASE_ACCESS_TOKEN
#    - VERCEL_TOKEN
#    - VERCEL_ORG_ID
#    - VERCEL_PROJECT_ID
# 4. Configurer les variables d'environnement dans Vercel (Dashboard)
# 5. Le workflow GitHub déploiera automatiquement sur Vercel
