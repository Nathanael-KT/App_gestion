# IMPORTANT: Ne pas commiter ce fichier en production
# Copier ce fichier en .env et remplir avec vos vraies valeurs

# =============================================================================
# SUPABASE CONFIGURATION (Production)
# =============================================================================
# URL de votre projet Supabase en production
SUPABASE_URL=https://your-project-ref.supabase.co
# Clé publique anon de Supabase  
SUPABASE_ANON_KEY=your_anon_public_key
# Clé de service role (SENSIBLE - garde secret)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# =============================================================================
# NUXT CONFIGURATION
# =============================================================================
# Variables publiques (exposées côté client)
NUXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NUXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_public_key
NUXT_PUBLIC_SITE_URL=https://your-domain.com

# Compatibilité éventuelle avec anciens scripts
SUPABASE_KEY=your_anon_public_key

# =============================================================================
# CRON / TÂCHES PLANIFIÉES
# =============================================================================
# Secret partagé protégeant /api/cron/update-subscription-status (appelé
# chaque jour : blocage/déblocage automatique des abonnements impayés après
# 1 jour de grâce). Générer une valeur aléatoire forte (ex: openssl rand -hex 32).
#
# Le secret est accepté via :
#   - le header "Authorization: Bearer <CRON_SECRET>" (format natif Vercel
#     Cron, voir la section "crons" de vercel.json — Vercel l'envoie
#     automatiquement si CRON_SECRET est défini dans les env vars), ou
#   - le header "x-cron-secret: <CRON_SECRET>" (appels manuels / GitHub
#     Actions / autre scheduler).
CRON_SECRET=your_random_cron_secret

# =============================================================================
# STRIPE (paiement des abonnements)
# =============================================================================
# Clé secrète Stripe (dashboard Stripe > Developers > API keys).
# Utiliser une clé de TEST (sk_test_...) tant que l'intégration n'est pas
# validée en production.
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

# Secret de signature du webhook (dashboard Stripe > Developers > Webhooks
# > votre endpoint > "Signing secret"). Indispensable pour vérifier que les
# événements reçus sur /api/stripe/webhook proviennent bien de Stripe.
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret

# URL publique de l'application, utilisée pour construire les URLs de
# redirection après paiement (success_url/cancel_url) et le retour du
# portail client. En production, mettre l'URL réelle du site.
PUBLIC_APP_URL=http://localhost:3000

# Après avoir créé les 2 produits/prix dans le dashboard Stripe (offres
# "Rapide" et "Pro", voir supabase/migrations/20260821090000_stripe_subscriptions.sql),
# reporter les stripe_price_id correspondants dans la table
# subscription_plans (colonne stripe_price_id), par exemple via le SQL
# Editor de Supabase :
#   update subscription_plans set stripe_price_id = 'price_xxx' where slug = 'rapide';
#   update subscription_plans set stripe_price_id = 'price_yyy' where slug = 'pro';

# =============================================================================
# DOCKER CONFIGURATION
# =============================================================================
# Configuration pour le déploiement Docker
NODE_ENV=production
NITRO_PORT=3000
NITRO_HOST=0.0.0.0

# =============================================================================
# DEVELOPPEMENT LOCAL
# =============================================================================
# Pour le développement local avec Supabase local
# SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_ANON_KEY=your_local_anon_key
# NUXT_PUBLIC_SITE_URL=http://localhost:3000

# =============================================================================
# INSTRUCTIONS DE DÉPLOIEMENT VERCEL + CI/CD
# =============================================================================
# 1. Créer un projet Supabase en production
# 2. Récupérer l'URL et les clés depuis le dashboard Supabase
# 3. Configurer GitHub Secrets pour le CI/CD :
#    - SUPABASE_URL
#    - SUPABASE_ANON_KEY  
#    - SUPABASE_SERVICE_ROLE_KEY
#    - SUPABASE_PROJECT_ID
#    - SUPABASE_ACCESS_TOKEN
#    - VERCEL_TOKEN
#    - VERCEL_ORG_ID
#    - VERCEL_PROJECT_ID
# 4. Configurer les variables d'environnement dans Vercel (Dashboard)
# 5. Le workflow GitHub déploiera automatiquement sur Vercel

# =============================================================================
# INNOVATIONS : Vision IA (photo -> fiche produit)
# =============================================================================
# Clé API compatible OpenAI Vision (OpenAI, OpenRouter, etc.).
# Sans cette clé, la fonctionnalité reste désactivée proprement côté serveur.
VISION_API_KEY=your_vision_api_key
# Endpoint compatible OpenAI Chat Completions (vision).
VISION_API_URL=https://api.openai.com/v1/chat/completions
VISION_API_MODEL=gpt-4o-mini

# =============================================================================
# INNOVATIONS : Mobile Money (MTN MoMo / Orange Money)
# =============================================================================
# MTN MoMo (sandbox pour les tests) : https://momodeveloper.mtn.com
MTN_MOMO_SUBSCRIPTION_KEY=your_mtn_subscription_key
MTN_MOMO_API_USER=your_mtn_api_user
MTN_MOMO_API_KEY=your_mtn_api_key
MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_MOMO_ENVIRONMENT=sandbox
# Orange Money Web Pay : https://developer.orange.com
ORANGE_MONEY_CLIENT_ID=your_orange_client_id
ORANGE_MONEY_CLIENT_SECRET=your_orange_client_secret
ORANGE_MONEY_MERCHANT_KEY=your_orange_merchant_key
ORANGE_MONEY_BASE_URL=https://api.orange.com/orange-money-webpay/dev/v1

# =============================================================================
# INNOVATIONS : Avance de trésorerie (partenaire de financement)
# =============================================================================
# Optionnel : URL + clé d'un partenaire de cash advance. Sans partenaire,
# le moteur calcule l'eligibilite a partir des ventes et genere une offre indicative.
FINANCING_PARTNER_API_URL=
FINANCING_PARTNER_API_KEY=

# =============================================================================
# INNOVATIONS : Feature flags publics (côté client)
# =============================================================================
# Mettre a "false" pour masquer une fonctionnalite dans l'UI.
NUXT_PUBLIC_ENABLE_PRODUCT_VISION=true
NUXT_PUBLIC_ENABLE_VOICE_SEARCH=true
NUXT_PUBLIC_ENABLE_QR_PAYMENT=true
NUXT_PUBLIC_ENABLE_CASH_ADVANCE=true
NUXT_PUBLIC_ENABLE_ANOMALY_DETECTION=true
# Langue de reconnaissance vocale (BCP-47). Ex: fr-FR, fr-CI, en-US.
NUXT_PUBLIC_VOICE_SEARCH_LANG=fr-FR
