{
  "name": "nuxt-app",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "build:ci": "nuxt build --no-typecheck",
    "build:vercel": "NITRO_PRESET=vercel nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "prepare": "husky",
    "deploy": "./deploy.sh",
    "deploy:manual": "pnpm dlx vercel@latest deploy --prod --yes",
    "build:production": "pnpm build:vercel",
    "supabase:setup": "npx supabase start",
    "supabase:push": "npx supabase db push",
    "supabase:types": "npx supabase gen types typescript --local > types/supabase.ts",
    "typecheck": "nuxt typecheck",
    "test": "echo 'No tests specified' && exit 0",
    "db:migrate": "supabase db push",
    "db:reset": "supabase db reset",
    "db:seed": "supabase db reset --with-seed",
    "deploy:prod": "pnpm dlx vercel@latest deploy --prod --yes",
    "setup:secrets": "./scripts/setup-github-secrets.sh"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.894.0",
    "@mdi/font": "^7.4.47",
    "@nuxt/eslint": "1.3.0",
    "@nuxt/image": "1.11.0",
    "@nuxt/ui": "^3.1.3",
    "@nuxthub/core": "0.8.27",
    "@nuxtjs/dotenv": "^1.4.2",
    "@nuxtjs/supabase": "1.5.0",
    "@pinia/nuxt": "^0.11.2",
    "@supabase/supabase-js": "^2.49.8",
    "axios": "^1.9.0",
    "chart.js": "^4.5.0",
    "chartjs-adapter-date-fns": "^3.0.0",
    "date-fns": "^4.1.0",
    "eslint": "^9.0.0",
    "jspdf": "^3.0.1",
    "lucide-vue-next": "^0.511.0",
    "nuxt": "^3.17.0",
    "pinia": "^3.0.3",
    "sonner": "^2.0.3",
    "tailwindcss": "^4.1.8",
    "vue": "^3.5.13",
    "vue-chartjs": "^5.3.2",
    "vue-router": "^4.5.1",
    "zod": "^3.25.41"
  },
  "packageManager": "pnpm@9.4.0+sha1.9217c800d4ab947a7aee520242a7b70d64fc7638",
  "devDependencies": {
    "@types/axios": "^0.14.4",
    "@typescript-eslint/eslint-plugin": "^8.33.0",
    "@typescript-eslint/parser": "^8.33.0",
    "eslint-plugin-vue": "^10.1.0",
    "husky": "^9.1.7",
    "nuxthub": "^0.9.1",
    "supabase": "^2.22.6",
    "vue-tsc": "3.2.6"
  }
}